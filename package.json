{
  "name": "santo-groceries",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@santo/api",
    "db:migrate:down": "npm run db:migrate:down --workspace=@santo/api",
    "db:seed": "npm run db:seed --workspace=@santo/api"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
